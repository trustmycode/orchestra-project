# Copy this file to infra/.env and fill every value marked as required.
POSTGRES_DB=orchestra
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=
POSTGRES_APP_USER=orchestra_app
POSTGRES_APP_PASSWORD=
POSTGRES_ADMIN_USER=orchestra_admin
POSTGRES_ADMIN_PASSWORD=

RABBITMQ_USER=orchestra
RABBITMQ_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

ORCHESTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ORCHESTRA_ADMIN_ENABLED=false
ORCHESTRA_ADMIN_TOKEN=
ORCHESTRA_RESOLVER_DB_ALLOWED_HOSTS=

# Exact comma-separated hosts available to scenario steps.
ORCHESTRA_HTTP_ALLOWED_HOSTS=
ORCHESTRA_HTTP_ALLOW_PRIVATE_NETWORKS=false
ORCHESTRA_DB_ALLOWED_HOSTS=postgres
ORCHESTRA_DB_ALLOW_MUTATIONS=false

APP_DB_HOST=postgres
APP_DB_PORT=5432
APP_RABBITMQ_HOST=rabbitmq
